# Kopyala: cp .env.example .env — sonra değerleri doldur. `.env` git'e GİRMEZ, izni 600 olur.

# --- Claude Code (NOVE-KURULUM.md §8) ---
# Nove'nin Anthropic Console organizasyonundan, aylık harcama limitiyle. Kişisel abonelik kullanılmaz.
ANTHROPIC_API_KEY=

# --- Denetçi (sirket/DENETCI.md) — sıra: NIM -> OpenAI -> Haiku ---
# Üreten Claude ise denetleyen başka aileden olmalı. Üçü de boşsa yedek yol Haiku'dur
# ve karar "denetçi aynı aileden — uyarı" notuyla kaydedilir.
NVIDIA_API_KEY=
# Boşsa varsayılan: openai/gpt-oss-20b. Katalog değişiyor: `bin/bekci_karsilastir.py` ile ölç.
NIM_BEKCI_MODEL=
OPENAI_API_KEY=

# --- farklı model (isteğe bağlı) ---
# Bir danışmanı Anthropic yerine NIM modeliyle koşturmak için, ör. meta/llama-3.3-70b-instruct (tool-use desteklemeli).
NIM_MODEL=

# --- Faz 4: Kalite danışmanı ---
# Yalnız SELECT yetkisi olan veritabanı rolü; ajan bu bağlantıyla yazma yapamaz (ANAYASA §1).
QA_READONLY_URL=

# --- Faz 7: zil (S1 netleşince) — biri yeter: API sorgusu ya da webhook ---
CRM_API_URL=
CRM_READONLY_TOKEN=
CRM_WEBHOOK_SECRET=
