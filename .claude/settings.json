{
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Write(./yanitlar/**)",
      "Edit(./yanitlar/**)",
      "Write(./formlar/onayli/**)",
      "Edit(./formlar/onayli/**)",
      "Write(./takimlar/*/kurallar.md)",
      "Edit(./takimlar/*/kurallar.md)",
      "Write(./ANAYASA.md)",
      "Edit(./ANAYASA.md)",
      "Write(./sirket/CEO-KIMLIGI.md)",
      "Edit(./sirket/CEO-KIMLIGI.md)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/bin/bekci.py",
            "timeout": 180
          }
        ]
      }
    ]
  }
}
